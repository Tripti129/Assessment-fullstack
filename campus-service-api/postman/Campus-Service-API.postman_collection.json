        {
          "name": "List Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "const s = d.staff.find(u => u.role === \"staff\");",
                  "if (s) pm.collectionVariables.set(\"staffId\", s._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/staff",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "staff"
              ]
            }
          }
        },
